# LLM Provider Configuration
# Supported providers: "openai" (default), "vllm", "custom"
LLM_PROVIDER=openai

# OpenAI Configuration (when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# vLLM / Self-hosted / Custom OpenAI-compatible API Configuration
# Use these when LLM_PROVIDER=vllm or LLM_PROVIDER=custom
LLM_API_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=not-needed-for-vllm
LLM_MODEL_NAME=meta-llama/Llama-2-7b-chat-hf

# Milvus (ExFever BM25 index built with scripts/graph_check/build_exfever_index.py)
MILVUS_URI=
MILVUS_TOKEN=
EXFEVER_MILVUS_COLLECTION=exfever_bm25
